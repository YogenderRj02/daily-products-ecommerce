app.use(cors());
app.use(express.json());

app.get("/api/health", (_req, res) => {
  res.json({ status: "ok", app: "DailyNest" });
});

app.get("/api/categories", (_req, res) => {
  const categories = ["All", ...new Set(products.map((product) => product.category))];
  res.json(categories);
});

app.get("/api/products", (req, res) => {
  const search = (req.query.search || "").toLowerCase();
  const category = req.query.category || "All";

  const filtered = products.filter((product) => {
    const matchesCategory = category === "All" || product.category === category;
    const matchesSearch =
      !search ||
      product.name.toLowerCase().includes(search) ||
      product.description.toLowerCase().includes(search) ||
      product.category.toLowerCase().includes(search);

    return matchesCategory && matchesSearch;
  });

  res.json({ products: filtered, categories: ["All", ...new Set(products.map((product) => product.category))] });
});

app.get("/api/products/:id", (req, res) => {
  const product = products.find((item) => item.id === Number(req.params.id));

  if (!product) {
    return res.status(404).json({ message: "Product not found" });
  }

  return res.json(product);
});

app.post("/api/auth/login", (req, res) => {
  const { email, name } = req.body || {};

  if (!email) {
    return res.status(400).json({ message: "Email is required to continue" });
  }

  return res.json({
    user: {
      id: "guest-user",
      name: name || "Daily Shopper",
      email,
      membership: "Prime Daily"
    }
  });
});

app.post("/api/orders", (req, res) => {
  const { items, customer } = req.body || {};

  if (!Array.isArray(items) || items.length === 0) {
    return res.status(400).json({ message: "Cart is empty" });
  }

  const total = items.reduce((sum, item) => sum + item.price * item.quantity, 0);

  return res.json({
    success: true,
    message: "Order placed successfully",
    order: {
      id: `ORD-${Date.now()}`,
      total,
      customer: customer || { name: "Guest" },
      items,
      status: "Confirmed"
    }
  });
});

app.listen(PORT, () => {
  console.log(`DailyNest server running on http://localhost:${PORT}`);
});
